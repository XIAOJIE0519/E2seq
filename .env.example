# E2seq environment template / E2seq 环境变量模板

# LLM configuration / LLM 配置
E2SEQ_LLM_PROVIDER=openai  # openai, anthropic, deepseek, ollama, or custom
E2SEQ_API_KEY=your-api-key-here
E2SEQ_MODEL=gpt-4
E2SEQ_TEMPERATURE=0.7
E2SEQ_MAX_TOKENS=8192

# Portable runtime / 可迁移运行环境（可选；start.py 也会交互式询问）
# E2SEQ_PYTHON=C:\path\to\python.exe
# E2SEQ_LIBRARY_PATH=C:\path\to\site-packages
# E2SEQ_R_EXE=C:\path\to\Rterm.exe
# E2SEQ_R_PATH=C:\path\to\R
E2SEQ_HOST=127.0.0.1
E2SEQ_PORT=8521
# E2SEQ_HF_ENDPOINT=https://huggingface.co

# Alternative providers / 其他 LLM 服务商
# ANTHROPIC_API_KEY=your-claude-key
# DEEPSEEK_API_KEY=your-deepseek-key

# Persistent storage / 持久化存储
E2SEQ_DATA_DIR=~/.e2seq/user_data
E2SEQ_DB_PATH=~/.e2seq/databases
E2SEQ_CACHE_ENABLED=true
E2SEQ_CACHE_TTL=3600

# Vector database / 向量数据库
CHROMA_PERSIST_DIR=~/.e2seq/chroma

# Network and logging / 网络与日志
API_RATE_LIMIT=10
API_TIMEOUT=30
LOG_LEVEL=INFO
LOG_FILE=~/.e2seq/logs/e2seq.log

# Legacy compatibility names / 兼容旧配置名
STREAMLIT_PORT=8521
STREAMLIT_SERVER_ADDRESS=127.0.0.1

# Security / 安全
RSA_KEY_SIZE=2048
ENCRYPTION_ENABLED=true
