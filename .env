# LLM Configuration
E2SC_LLM_PROVIDER=siliconflow  # openai, anthropic, deepseek, ollama
E2SC_API_KEY=sk-lbolzgmciylrozghztypcxcncmxmosjcjcnwnmfznfjttrxb
E2SC_MODEL=Qwen/Qwen2.5-7B-Instruct
E2SC_TEMPERATURE=0.7
E2SC_MAX_TOKENS=4096

# Alternative LLM providers
# ANTHROPIC_API_KEY=your-claude-key
# DEEPSEEK_API_KEY=your-deepseek-key

# Database Configuration
E2SC_DB_PATH=~/.e2sc/databases
E2SC_CACHE_ENABLED=true
E2SC_CACHE_TTL=3600

# External API Keys
# BioGRID: https://webservice.thebiogrid.org/support/api_keys
E2SC_BIOGRID_API_KEY=d906c6d18e461b2d2936cbc445b2b846

# Redis (optional, for distributed caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Vector Database
CHROMA_PERSIST_DIR=~/.e2sc/chroma

# API Rate Limiting
API_RATE_LIMIT=10  # requests per second
API_TIMEOUT=30  # seconds

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=~/.e2sc/logs/e2sc.log

# Web Interface
STREAMLIT_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Security
RSA_KEY_SIZE=2048
ENCRYPTION_ENABLED=true
